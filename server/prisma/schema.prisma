// Agentarium data model (plan §3). PostgreSQL + Prisma.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  ua
  en
}

enum PostType {
  agent
  project
  article
  skill
  thought
}

enum JoinStatus {
  pending
  approved
  rejected
}

enum FriendStatus {
  pending
  accepted
}

enum MemberRole {
  owner
  member
}

enum InviteStatus {
  pending
  accepted
  rejected
}

enum ChatType {
  direct
  group
}

enum GithubMode {
  manual
  oauth
}

model User {
  id                 String   @id @default(cuid())
  nickname           String   @unique
  passwordHash       String
  avatarUrl          String?
  bio                String?
  socialLinks        String[] @default([])
  githubConnected    Boolean  @default(false)
  githubMode         GithubMode?
  githubUsername     String?
  githubUrl          String?
  githubAccessToken  String? // AES-256-GCM encrypted at rest
  githubReposCache   Json?
  githubCachedAt     DateTime?
  locale             Locale   @default(ua)
  createdAt          DateTime @default(now())

  posts            Post[]
  comments         Comment[]
  postVotes        PostVote[]
  postReactions    PostReaction[]
  projects         Project[]
  agents           Agent[]
  skills           Skill[]
  achievements     UserAchievement[]
  ownedCommunities Community[]        @relation("CommunityOwner")
  memberships      CommunityMember[]
  invitesReceived  CommunityInvite[]  @relation("InviteTarget")
  invitesSent      CommunityInvite[]  @relation("InviteSender")
  threads          Thread[]
  chatMemberships  ChatMember[]
  messages         Message[]
  reviewedRequests JoinRequest[]      @relation("ReviewedBy")
  bookmarks        Bookmark[]
  notifications    Notification[]     @relation("NotifRecipient")
  actedNotifs      Notification[]     @relation("NotifActor")

  @@index([nickname])
}

model JoinRequest {
  id                String     @id @default(cuid())
  applicantNickname String
  passwordHash      String? // set when applying via the register tab
  bio               String?
  motivation        String?
  githubUrl         String?
  status            JoinStatus @default(pending)
  reviewedBy        User?      @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedById      String?
  createdAt         DateTime   @default(now())

  @@index([status, createdAt])
}

model Friendship {
  id            String       @id @default(cuid())
  userAId       String
  userBId       String
  requestedById String
  status        FriendStatus @default(pending)
  createdAt     DateTime     @default(now())

  @@unique([userAId, userBId])
  @@index([userBId, status])
}

model Community {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  isPrivate   Boolean  @default(false)
  owner       User     @relation("CommunityOwner", fields: [ownerId], references: [id])
  ownerId     String
  createdAt   DateTime @default(now())

  members CommunityMember[]
  invites CommunityInvite[]
  posts   Post[]
  threads Thread[]
  chats   Chat[]
}

model CommunityMember {
  id          String     @id @default(cuid())
  community   Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  role        MemberRole @default(member)
  joinedAt    DateTime   @default(now())

  @@unique([communityId, userId])
  @@index([userId])
}

model CommunityInvite {
  id            String       @id @default(cuid())
  community     Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId   String
  invitedUser   User         @relation("InviteTarget", fields: [invitedUserId], references: [id])
  invitedUserId String
  invitedBy     User         @relation("InviteSender", fields: [invitedById], references: [id])
  invitedById   String
  status        InviteStatus @default(pending)
  createdAt     DateTime     @default(now())

  @@unique([communityId, invitedUserId])
  @@index([invitedUserId, status])
}

model Post {
  id          String     @id @default(cuid())
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  type        PostType
  community   Community? @relation(fields: [communityId], references: [id])
  communityId String?
  title       String
  bodyHtml    String     @default("")
  codeSnippet String?
  linkUrl     String?
  linkTitle   String?
  imageUrl    String?
  pinned      Boolean    @default(false)
  tags        String[]   @default([])
  createdAt   DateTime   @default(now())

  votes     PostVote[]
  reactions PostReaction[]
  comments  Comment[]
  bookmarks Bookmark[]

  @@index([communityId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
}

model PostVote {
  id     String @id @default(cuid())
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  value  Int // +1 or -1

  @@unique([postId, userId])
  @@index([postId])
}

model PostReaction {
  id     String @id @default(cuid())
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  emoji  String @default("🔥")

  @@unique([postId, userId, emoji])
  @@index([postId])
}

model Comment {
  id              String    @id @default(cuid())
  post            Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId          String?
  thread          Thread?   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId        String?
  parent          Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id])
  parentCommentId String?
  replies         Comment[] @relation("CommentReplies")
  author          User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId        String
  bodyHtml        String
  score           Int       @default(0)
  createdAt       DateTime  @default(now())

  @@index([postId, createdAt])
  @@index([threadId, createdAt])
}

model Thread {
  id          String    @id @default(cuid())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId String
  author      User      @relation(fields: [authorId], references: [id])
  authorId    String
  title       String
  createdAt   DateTime  @default(now())

  comments Comment[]

  @@index([communityId, createdAt])
}

model Chat {
  id          String     @id @default(cuid())
  type        ChatType
  title       String?
  community   Community? @relation(fields: [communityId], references: [id])
  communityId String?
  createdAt   DateTime   @default(now())

  members  ChatMember[]
  messages Message[]
}

model ChatMember {
  id         String    @id @default(cuid())
  chat       Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())

  @@unique([chatId, userId])
  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId    String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  body      String
  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
}

model Project {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  title         String
  description   String?
  githubRepoUrl String?
  status        String?
  createdAt     DateTime @default(now())

  @@index([userId])
}

model Agent {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  title         String
  description   String?
  framework     String?
  demoOrRepoUrl String?
  tags          String[] @default([])
  createdAt     DateTime @default(now())

  @@index([userId])
}

model Skill {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  tag    String

  @@unique([userId, tag])
}

model Achievement {
  id                   String @id @default(cuid())
  code                 String @unique
  title                String
  icon                 String
  conditionDescription String

  users UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  achievementId String
  earnedAt      DateTime    @default(now())

  @@unique([userId, achievementId])
}

model Bookmark {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId, createdAt])
}

enum NotificationType {
  comment
  reply
  upvote
  fire
  mention
  friend_request
  friend_accept
  community_invite
  join_request
}

model Notification {
  id          String           @id @default(cuid())
  user        User             @relation("NotifRecipient", fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  actor       User?            @relation("NotifActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId     String?
  type        NotificationType
  postId      String?
  commentId   String?
  chatId      String?
  communityId String?
  text        String?
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([userId, read, createdAt])
}
