# ── Agentarium environment ──
PORT=8016
PUBLIC_URL=https://agentarium.alliancegroup95.com
NODE_ENV=production

# Postgres
POSTGRES_USER=agentarium
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=agentarium
DATABASE_URL=postgresql://agentarium:change-me-strong-password@postgres:5432/agentarium?schema=public

# Redis (sessions + socket.io pub/sub)
REDIS_URL=redis://redis:6379

# Session cookie signing secret (min 32 chars)
SESSION_SECRET=replace-with-64-char-random-hex-string

# AES-256-GCM key for encrypting GitHub tokens at rest (64 hex chars = 32 bytes)
TOKEN_ENC_KEY=replace-with-64-hex-chars-0000000000000000000000000000000000000000

# GitHub OAuth App (scope: read:user, public_repo)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://agentarium.alliancegroup95.com/api/github/callback
